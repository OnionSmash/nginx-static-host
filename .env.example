# Environment variables for demo.stacklume.cloud backend
# Copy this file to .env and fill in the values.

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# (These are pre-set for docker-compose; override only if needed)
# CHROMA_HOST=chroma
# CHROMA_PORT=8000
# CHROMA_COLLECTION=stacklume_docs

# ── RAG tuning ────────────────────────────────────────────────────────────────
# RETRIEVAL_K=5
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
