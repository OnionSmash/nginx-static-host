# Dockerfile – nginx v1.1 (Secure & Performant + API Proxy)
#
# This is a reference template. Copy it to your project root alongside
# your public/ directory and nginx.conf, then run:
#   docker build -t my-site:1.1 .
#
# In the full stack, docker-compose.yml serves static files via a bind mount
# and proxies /api/* to the backend service instead of building this image.
FROM nginx:alpine

# Copy static site files (relative to the build context = project root)
COPY public/ /usr/share/nginx/html

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Inherit default CMD from base image: nginx -g "daemon off;"
